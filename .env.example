# DEADRYX Environment Configuration Reference
# Note: DEADRYX is a client-side offline-first PWA.
# Client-side Google OAuth credentials can be configured here if automated deployment pipelines inject them.

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# Required scopes: https://www.googleapis.com/auth/drive.appdata, https://www.googleapis.com/auth/userinfo.profile
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Base Application URL
APP_URL=https://deadryx.netlify.app
